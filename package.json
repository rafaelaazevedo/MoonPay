{
  "name": "moonpaytest",
  "version": "1.0.0",
  "description": "Test Project for the MoonPay Interview",
  "main": "index.js",
  "scripts": {
    "cy:open": "cypress open",
    "e2e": "cypress run",
    "report:clean": "rm -rf artifacts/",
    "format:fix": "prettier --write '**/*.{js,json}'",
    "format": "prettier --check '**/*.{js,json}'",
    "lint:fix": "eslint --fix '**/*.js'",
    "lint": "eslint '**/*.js'"
  },
  "keywords": [
    "test",
    "qa",
    "cypress",
    "moonpay"
  ],
  "author": "Rafaela Azevedo",
  "license": "ISC",
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{js,json,md}": [
      "prettier --write",
      "git add"
    ],
    "**/*.js": [
      "eslint",
      "git add"
    ]
  },
  "eslintIgnore": [
    "artifacts/**/*.js"
  ],
  "devDependencies": {
    "cypress": "^10.7.0",
    "cypress-commands": "^1.1.0",
    "cypress-iframe": "^1.0.1",
    "cypress-multi-reporters": "^1.4.0",
    "cypress-wait-until": "^1.7.1",
    "eslint": "^7.21.0",
    "eslint-plugin-cypress": "^2.11.2",
    "husky": "^5.1.3",
    "lint-staged": "^10.5.4",
    "mocha": "^10.0.0",
    "prettier": "^2.2.1"
  }
}
